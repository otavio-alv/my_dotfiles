configuration {
    modi:                 "drun,calc";
    font:                 "Envy Code R Nerd Font 11";
    show-icons:           true;
    terminal:             "kitty";
    drun-display-format:  "{icon} {name}";
    disable-history:      false;
    sort:                 true;
    matching:             "fuzzy";

    display-drun:         "APPS";
    display-calc:         "CALC";

    calc-command:         "echo -n '{result}' | wl-copy";
}

@theme "/home/otavioalv/.config/rofi/themes/hacker.rasi"